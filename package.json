{
  "private": true,
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun run --filter @backlog-mcp/shared build && bun run --filter @backlog-mcp/viewer typecheck && bun --bun vite build && bun run --filter backlog-mcp build",
    "build:viewer": "bun run --filter @backlog-mcp/shared build && bun run --filter @backlog-mcp/viewer typecheck && bun --bun vite build",
    "typecheck": "bun run --filter backlog-mcp typecheck && bun run --filter @backlog-mcp/viewer typecheck",
    "test": "bun run --filter \"./packages/*\" test",
    "test:watch": "bun run --filter backlog-mcp test:watch",
    "search:eval": "bun scripts/search-eval.mjs",
    "suite:structural": "bun scripts/structural-suite.mjs",
    "usage:report": "bun scripts/usage-report.mjs",
    "qrels:implicit": "bun scripts/implicit-qrels.mjs",
    "dev": "bun --bun vite",
    "clean": "bun run --filter \"./packages/*\" clean",
    "start": "bun run --filter backlog-mcp start",
    "deploy": "bun run --filter backlog-mcp deploy",
    "deploy:preview": "bun run --filter backlog-mcp deploy:preview",
    "inspect": "bun run build && bunx --bun @modelcontextprotocol/inspector packages/server/dist/cli/index.mjs"
  },
  "devDependencies": {
    "@nisli/core": "^0.54.0",
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.7.0",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.10",
    "bun-types": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ]
}
